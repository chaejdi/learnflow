# ============================================
# LearnFlow (런플로우) 환경변수 설정
# ============================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# cp .env.example .env.local

# --- Supabase ---
# Supabase 프로젝트 URL (필수)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase Anon Key - 클라이언트용 (필수)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase Service Role Key - 서버 전용, 절대 공개하지 마세요 (필수)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic AI ---
# Claude API 키 (필수)
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- 카카오 API ---
# 카카오 REST API 키 (카카오톡 연동 시 필수)
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# 카카오 웹훅 검증 토큰 (선택)
KAKAO_WEBHOOK_VERIFY_TOKEN=your-verify-token

# --- 앱 설정 ---
# 서비스 URL (배포 후 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Node 환경 (development | production)
NODE_ENV=development
